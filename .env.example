TELEGRAM_BOT_TOKEN=
# Optional, for servers where Telegram is reachable only through a proxy.
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
CUDA_VISIBLE_DEVICES=3
MODEL_DEVICE=cuda
QWEN_ENABLED=false
QWEN_MIN_VRAM_GB=20
OUTPUT_DIR=data/outputs
TEMP_DIR=data/tmp
INPUT_DIR=data/inputs
FASHN_WEIGHTS_DIR=weights/fashn-vton-1.5
FASHN_CATEGORY=tops
# Set true for 8 GB cards such as RTX 2070; uses less VRAM at a small quality cost.
FASHN_LOW_MEMORY=false
FASHN_NUM_TIMESTEPS=20
FLUX_MODEL_ID=black-forest-labs/FLUX.1-schnell
LOG_LEVEL=INFO
